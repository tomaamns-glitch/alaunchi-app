node_modules/
dist/
release/
*.log
.DS_Store

# electron-updater's own dev-mode convention — makes `electron .` (unpacked,
# no NODE_ENV=development) actually run a real update check against the
# public release feed instead of silently skipping forever. Local-only, never
# read by the packaged app (which uses its own generated app-update.yml).
dev-app-update.yml

# Embedded read-only/crash-report tokens for the packaged build — real values
# live only in the local .env, never committed (this source repo is public).
.env
.env.*
!.env.example

# Stray Minecraft runtime data — a game launch used this folder as its working
# directory instead of an isolated instance dir; none of this is app source.
/config/
/customnpcs/
/logs/
/patchouli_books/
/schematics/
/patchouli_data.json
hs_err_pid*.log
