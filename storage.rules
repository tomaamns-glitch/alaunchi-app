rules_version = '2';

// Images other players see are written only by the uploadModeratedImage Cloud
// Function (Admin SDK, bypasses these rules) after passing moderation.
service firebase.storage {
  match /b/{bucket}/o {
    // Profile banners and modpack logos/banners: moderated uploads only.
    match /banners/{uuid}/{file} {
      allow read: if true;
      allow write: if false;
    }

    // Shared chat content. Mods, schematics, etc. are still uploaded straight
    // from the app (too big for a function call, and not images); image files
    // go through the function. A client may not stamp the "moderated" flag
    // itself — the moderateStorageUpload backstop checks any image without it.
    match /content-objects/{sha1} {
      allow read: if true;
      allow create: if request.resource.size < 512 * 1024 * 1024
        && !(request.resource.contentType.matches('image/.*'))
        && (request.resource.metadata == null
            || !('moderated' in request.resource.metadata));
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
