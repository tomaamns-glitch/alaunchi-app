# Copy to .env and fill in with real values before building. See CLAUDE.md
# for the token-scoping rules (each one must stay least-privilege).

# Fine-grained PAT, Contents: Read-only, scoped to the Modpacks repo only.
VITE_MODPACKS_READER_TOKEN=

# Dedicated repo used only for auto-filed crash-report issues.
VITE_CRASH_REPORT_REPO=https://github.com/tomaamns-glitch/alaunchi-reports

# Fine-grained PAT, Issues: Read & write only (no Contents access), scoped to
# the crash-report repo above.
VITE_CRASH_REPORT_TOKEN=
